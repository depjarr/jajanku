# ---------- Supabase (wajib) ----------
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---------- AI ----------
# gratis = Gemini (cadangan Groq) + potong stiker di browser
# fal    = fal.ai (berbayar, stiker paling rapi)
AI_PROVIDER=gratis

# Gemini (gratis) → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model dicoba berurutan; kalau sibuk/kena batas, pindah ke berikutnya
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# Groq (gratis, opsional, cadangan) → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# fal.ai (opsional, berbayar) → https://fal.ai/dashboard/keys
FAL_KEY=
FAL_VISION_MODEL=google/gemini-2.5-flash
